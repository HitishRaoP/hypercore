{
	"name": "hypercore",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"format-and-lint": "biome check . --max-diagnostics=200 ",
		"format-and-lint:fix": "biome check . --write --max-diagnostics=200 ",
		"check-types": "turbo run check-types"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"prettier": "^3.7.4",
		"turbo": "^2.10.10",
		"typescript": "5.9.2"
	},
	"engines": {
		"node": ">=18"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.2.5"
		}
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
