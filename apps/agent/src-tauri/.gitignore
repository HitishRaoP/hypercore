# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Fetched helper binaries (esbuild + javy) — downloaded by
# apps/agent/scripts/fetch-tools.mjs and bundled via bundle.resources.
# Never commit binaries; each build machine fetches its native copy.
/resources/tools/*
!/resources/tools/.gitkeep

# Updater signing keys must never live in the repo. The public key is
# committed inside tauri.conf.json; the private key belongs in the
# TAURI_SIGNING_PRIVATE_KEY GitHub secret only.
*.key
*.key.pub
