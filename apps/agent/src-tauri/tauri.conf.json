{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agent",
  "version": "0.2.0",
  "identifier": "com.hypercore.agent",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HyperCore Agent",
        "width": 920,
        "height": 680,
        "minWidth": 620,
        "minHeight": 520,
        "decorations": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "resources": ["resources/tools"]
  }
}
